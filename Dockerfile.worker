# Upstream MIT license retained in /app/LICENSE.
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build
FROM build AS test
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
# History-based upstream tests require this real pinned ancestor.
RUN git init && git remote add upstream https://github.com/vpontual/veepee-code.git && git fetch upstream 8383dc8400e1fae3bf89fb5b20528cabf0d96843 && git reset --mixed FETCH_HEAD
RUN chown -R node:node /app
USER node
RUN git config --global user.email test@example.invalid && git config --global user.name Test
RUN npm test
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS runtime
ARG VCS_REF=uncommitted
LABEL org.opencontainers.image.source="https://github.com/RPHllc/veepee-code" org.opencontainers.image.revision=$VCS_REF org.opencontainers.image.licenses="MIT"
WORKDIR /app
ENV NODE_ENV=production HOME=/tmp/vcode TERM=dumb
COPY --from=build /app/package*.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY LICENSE ./LICENSE
USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["node", "/app/dist/worker.js"]
